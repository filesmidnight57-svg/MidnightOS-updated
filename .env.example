# AI generation
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# YouTube (official OAuth; public is the existing MidnightOS workflow default)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_REDIRECT_URI=http://localhost:53682/oauth2callback
YOUTUBE_PRIVACY_STATUS=public
YOUTUBE_PUBLISH_MODE=live

# Meta Graph API (official Page/Professional-account publishing)
META_GRAPH_API_VERSION=v24.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_UPLOAD_ENABLED=false
FACEBOOK_MAX_DURATION_SECONDS=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_UPLOAD_ENABLED=false
# An HTTPS base URL that already serves the generated MP4s, e.g. https://media.example.com/midnightos
PUBLIC_MEDIA_BASE_URL=
# Or set an already-hosted HTTPS video for dry integration checks.
PUBLIC_MEDIA_STATIC_URL=

# Local dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
# DASHBOARD_PASSWORD=optional-local-password
